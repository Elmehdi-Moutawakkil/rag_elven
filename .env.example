# RAG Elven Environment Variables
# Copy this to .env and fill in your actual values

# Groq API Key
# Get a free key at: https://console.groq.com
GROQ_API_KEY=

# Anthropic API Key
# Required for lore generation and inspector judging
ANTHROPIC_API_KEY=

# OpenAI API Key
# Optional. API billing is separate from a ChatGPT subscription.
OPENAI_API_KEY=

# DeepSeek API Key
# Used by the default lore provider. Create a key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Optional: Model selection (default: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_LORE_MODEL=openai/gpt-oss-20b
# OPENAI_MODEL=gpt-4o-mini
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_LORE_MODEL=deepseek-flash
# ANTHROPIC_LORE_MODEL=claude-sonnet-4-6
# QA_PROVIDER=deepseek

# Optional: local OpenAI-compatible endpoints
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL_NAME=local-model

# Optional: Temperature for LLM (default: 0.3, range 0-1)
# Lower = more factual, Higher = more creative
# LLM_TEMPERATURE=0.3

# Optional: Max tokens for LLM response (default: 512)
# LLM_MAX_TOKENS=512
