# RAG Elven Environment Variables
# Copy this to .env and fill in your actual values

# Groq API Key
# Get a free key at: https://console.groq.com
GROQ_API_KEY=

# Anthropic API Key
# Required for lore generation and inspector judging
ANTHROPIC_API_KEY=

# OpenAI API Key
# Optional. API billing is separate from a ChatGPT subscription.
OPENAI_API_KEY=

# Optional: Model selection (default: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_LORE_MODEL=claude-sonnet-4-6

# Optional: local OpenAI-compatible endpoints
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL_NAME=local-model

# Optional: Temperature for LLM (default: 0.3, range 0-1)
# Lower = more factual, Higher = more creative
# LLM_TEMPERATURE=0.3

# Optional: Max tokens for LLM response (default: 512)
# LLM_MAX_TOKENS=512
